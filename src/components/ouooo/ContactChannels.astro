---
import { CONTACT_EMAIL, GENERAL_WHATSAPP_URL, WECHAT_ID, WHATSAPP_DISPLAY } from '~/config/contact';

const wechatQrSrc = 'https://rosarybase.com/customer_service/wx.jpg';
---

<details class="contact-dock" data-contact-dock>
  <summary aria-label="Open contact options">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path
        d="M4 5.75A3.75 3.75 0 0 1 7.75 2h8.5A3.75 3.75 0 0 1 20 5.75v5.5A3.75 3.75 0 0 1 16.25 15H11l-4.55 3.64A.9.9 0 0 1 5 17.94V15.2a3.75 3.75 0 0 1-1-2.55v-6.9Z"
      ></path>
      <circle cx="8" cy="8.5" r="1"></circle><circle cx="12" cy="8.5" r="1"></circle><circle cx="16" cy="8.5" r="1"
      ></circle>
    </svg>
    <span>Contact us</span>
  </summary>

  <div class="contact-panel">
    <div class="panel-heading">
      <p>Contact OUOOO</p>
      <span>Choose the channel that works for you.</span>
    </div>

    <a class="channel-link" href={GENERAL_WHATSAPP_URL} target="_blank" rel="noopener noreferrer" data-contact-whatsapp>
      <span class="channel-icon whatsapp" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img">
          <path d="M12 3.25a8.25 8.25 0 0 0-7.08 12.5L3.8 20.2l4.57-1.1A8.25 8.25 0 1 0 12 3.25Z"></path>
          <path
            class="whatsapp-phone"
            d="M8.35 7.55c.32-.32.64-.25.84-.24.2 0 .42.02.57.38l.78 1.9c.12.3.07.52-.1.74l-.57.7c-.17.2-.14.4-.02.61.67 1.18 1.66 2.15 2.86 2.8.22.12.41.13.6-.07l.76-.88c.2-.23.45-.28.73-.16l1.81.86c.3.14.4.34.36.62-.08.6-.43 1.35-.92 1.72-.48.37-1.12.58-1.84.45-1.1-.2-2.59-.77-4.27-2.23-1.4-1.22-2.42-2.66-2.76-3.79-.36-1.2-.04-2.5.57-3.36Z"
          ></path>
        </svg>
      </span>
      <span><strong>WhatsApp</strong><small dir="ltr">{WHATSAPP_DISPLAY}</small></span>
      <span aria-hidden="true">→</span>
    </a>

    <details class="wechat-channel">
      <summary class="channel-link">
        <span class="channel-icon wechat" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img">
            <path
              d="M10.15 4.1c-4.2 0-7.6 2.77-7.6 6.2 0 1.9 1.05 3.6 2.7 4.73l-.7 2.27 2.65-1.32c.91.34 1.9.52 2.95.52.3 0 .59-.02.87-.05a5.9 5.9 0 0 1-.38-2.06c0-3.42 3.08-6.2 6.9-6.2h.11C16.62 5.8 13.72 4.1 10.15 4.1Zm-2.6 4.5a.91.91 0 1 1 0-1.82.91.91 0 0 1 0 1.82Zm5.2 0a.91.91 0 1 1 0-1.82.91.91 0 0 1 0 1.82Z"
            ></path>
            <path
              d="M21.45 14.4c0-2.78-2.78-5.03-6.2-5.03s-6.2 2.25-6.2 5.03 2.78 5.03 6.2 5.03c.86 0 1.68-.14 2.42-.4l2.16 1.08-.57-1.86c1.34-.92 2.19-2.3 2.19-3.85Zm-8.24-.9a.77.77 0 1 1 0-1.54.77.77 0 0 1 0 1.54Zm4.08 0a.77.77 0 1 1 0-1.54.77.77 0 0 1 0 1.54Z"
            ></path>
            <circle class="wechat-eye" cx="7.55" cy="7.69" r="0.62"></circle>
            <circle class="wechat-eye" cx="12.75" cy="7.69" r="0.62"></circle>
            <circle class="wechat-eye" cx="13.21" cy="12.73" r="0.52"></circle>
            <circle class="wechat-eye" cx="17.29" cy="12.73" r="0.52"></circle>
          </svg>
        </span>
        <span><strong>WeChat</strong><small dir="ltr">{WECHAT_ID}</small></span>
        <span aria-hidden="true">⌄</span>
      </summary>
      <div class="wechat-qr">
        <img src={wechatQrSrc} width="200" height="200" alt={`WeChat QR code for ${WECHAT_ID}`} loading="lazy" />
        <p>Scan the QR code or search <strong>{WECHAT_ID}</strong>.</p>
      </div>
    </details>

    <a class="channel-link" href={`mailto:${CONTACT_EMAIL}`} data-contact-email>
      <span class="channel-icon email">@</span>
      <span><strong>Email</strong><small dir="ltr">{CONTACT_EMAIL}</small></span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</details>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const dock = document.querySelector<HTMLDetailsElement>('[data-contact-dock]');
    if (!dock) return;

    // Handle trigger buttons (e.g. "Contact us about this product" on product pages)
    const trigger = target.closest<HTMLElement>('[data-contact-trigger]');
    if (trigger) {
      event.preventDefault();

      const whatsappLink = dock.querySelector<HTMLAnchorElement>('[data-contact-whatsapp]');
      const emailLink = dock.querySelector<HTMLAnchorElement>('[data-contact-email]');

      if (whatsappLink && trigger.dataset.whatsappUrl) whatsappLink.href = trigger.dataset.whatsappUrl;
      if (emailLink && trigger.dataset.emailUrl) emailLink.href = trigger.dataset.emailUrl;

      dock.open = true;
      dock.querySelector<HTMLElement>('.contact-panel')?.focus({ preventScroll: true });
      return;
    }

    // Close the dock when clicking anywhere outside of it
    if (dock.open && !target.closest('[data-contact-dock]')) {
      dock.open = false;
      const wechatDetails = dock.querySelector<HTMLDetailsElement>('.wechat-channel');
      if (wechatDetails) wechatDetails.open = false;
      return;
    }

    // Close the WeChat sub-panel when clicking outside of it (but still inside the dock)
    const wechatDetails = dock.querySelector<HTMLDetailsElement>('.wechat-channel');
    if (wechatDetails && wechatDetails.open && !target.closest('.wechat-channel')) {
      wechatDetails.open = false;
    }
  });

  // Also close on Escape key for accessibility
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const dock = document.querySelector<HTMLDetailsElement>('[data-contact-dock]');
    if (!dock || !dock.open) return;
    dock.open = false;
    const wechatDetails = dock.querySelector<HTMLDetailsElement>('.wechat-channel');
    if (wechatDetails) wechatDetails.open = false;
  });
</script>

<style>
  .contact-dock {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
  }
  .contact-dock > summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 999px;
    background: #0f3b2f;
    padding: 0.78rem 1rem;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: 0 12px 30px rgb(9 42 33 / 0.24);
    transition:
      background 0.18s ease,
      transform 0.18s ease;
  }
  .contact-dock > summary::-webkit-details-marker,
  .wechat-channel > summary::-webkit-details-marker {
    display: none;
  }
  .contact-dock > summary:hover {
    background: #092a21;
    transform: translateY(-2px);
  }
  .contact-dock > summary:focus-visible,
  .channel-link:focus-visible {
    outline: 3px solid rgb(178 138 82 / 0.55);
    outline-offset: 3px;
  }
  .contact-dock > summary svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: currentColor;
  }
  .contact-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    width: min(20rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid rgb(37 42 38 / 0.1);
    border-radius: 1.15rem;
    background: #fff;
    padding: 0.7rem;
    box-shadow: 0 20px 55px rgb(9 42 33 / 0.2);
  }
  .panel-heading {
    padding: 0.55rem 0.65rem 0.8rem;
  }
  .panel-heading p {
    font-weight: 700;
    color: #1d211e;
  }
  .panel-heading span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: rgb(29 33 30 / 0.66);
  }
  .channel-link {
    display: grid;
    width: 100%;
    cursor: pointer;
    list-style: none;
    grid-template-columns: 2.3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    border-radius: 0.85rem;
    padding: 0.65rem;
    color: #1d211e;
    text-decoration: none;
  }
  .channel-link:hover {
    background: #f6f1e8;
  }
  .channel-link strong,
  .channel-link small {
    display: block;
  }
  .channel-link strong {
    font-size: 0.88rem;
  }
  .channel-link small {
    margin-top: 0.1rem;
    overflow-wrap: anywhere;
    color: rgb(29 33 30 / 0.66);
    font-size: 0.72rem;
  }
  .channel-icon {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    place-items: center;
    border-radius: 999px;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
  }
  .channel-icon svg {
    width: 1.55rem;
    height: 1.55rem;
    fill: currentColor;
  }
  .channel-icon .whatsapp-phone {
    fill: #128c4a;
  }
  .channel-icon .wechat-eye {
    fill: #07c160;
  }
  .whatsapp {
    background: #128c4a;
  }
  .wechat {
    background: #07c160;
    font-size: 0.9rem;
  }
  .email {
    background: #0f3b2f;
    font-size: 1rem;
  }
  .wechat-qr {
    margin: 0.3rem 0.65rem 0.65rem;
    border-radius: 0.8rem;
    background: #f6f8f5;
    padding: 0.75rem;
    text-align: center;
  }
  .wechat-qr img {
    width: min(9rem, 100%);
    height: auto;
    margin-inline: auto;
  }
  .wechat-qr p {
    margin-top: 0.55rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: rgb(29 33 30 / 0.7);
  }
  @media (max-width: 520px) {
    .contact-dock {
      right: 1rem;
      bottom: 1rem;
    }
    .contact-dock > summary {
      padding: 0.82rem;
    }
    .contact-dock > summary span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
