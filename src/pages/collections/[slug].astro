---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { BUILD_LOCALE } from '~/i18n/config';
import { ui } from '~/i18n/ui';
import { getCollection } from '~/server/catalog';

export const prerender = false;

const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const collection = await getCollection(BUILD_LOCALE, Astro.params.slug || '', requestedPage, 24);
if (!collection) return new Response(null, { status: 404, statusText: 'Collection not found' });
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');
const metadata = {
  title: ui('collectionMetaTitle', { name: collection.name }),
  description: ui('collectionMetaDescription', { name: collection.name.toLowerCase() }),
};
---

<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-7xl px-6 py-14 sm:py-16">
      <nav class="text-sm text-muted" aria-label="Breadcrumb">
        <a class="hover:text-primary" href="/collections">{ui('collections')}</a><span aria-hidden="true">
          /
        </span><span>{collection.name}</span>
      </nav>
      <p class="mt-8 text-xs font-semibold uppercase tracking-[.16em] text-primary">{ui('productSeries')}</p>
      <h1 class="mt-4 text-4xl font-semibold text-gray-950 sm:text-5xl">{collection.name}</h1>
      <p class="mt-4 text-base text-muted">
        {
          ui('synchronizedInCollection', {
            count: collection.total,
            items: ui(collection.total === 1 ? 'product' : 'products'),
          })
        }
      </p>
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-6 py-14 sm:py-16">
    <div class="grid gap-x-7 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {collection.products.map((product) => <ProductCard product={product} />)}
    </div>
    {
      collection.total > collection.pageSize && (
        <nav class="mt-12 flex justify-center gap-4" aria-label="Collection pagination">
          {collection.page > 1 && <a href={`?page=${collection.page - 1}`}>{ui('previous')}</a>}
          <span>
            {ui('pageOf', { page: collection.page, pages: Math.ceil(collection.total / collection.pageSize) })}
          </span>
          {collection.page * collection.pageSize < collection.total && (
            <a href={`?page=${collection.page + 1}`}>{ui('next')}</a>
          )}
        </nav>
      )
    }
  </section>
</Layout>
