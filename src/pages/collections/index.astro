---
import Layout from '~/layouts/PageLayout.astro';
import ProductVisual from '~/components/ouooo/ProductVisual.astro';
import { BUILD_LOCALE } from '~/i18n/config';
import { ui } from '~/i18n/ui';
import { listCollections } from '~/server/catalog';
import type { Product } from '~/data/products';
import navigationCollections from '~/data/navigation-collections.json';

type CuratedCollection = { slug: string; name: string };
type CollectionSummary = { slug: string; productCount: number; featuredProductJson: string };

export const prerender = false;
// The collections page is driven by the curated navigation list so links and
// display names can be filled in manually per language, instead of being
// auto-generated from the product catalog.
const catalogCollections = await listCollections(BUILD_LOCALE);
const bySlug = new Map<string, CollectionSummary>(catalogCollections.map((c) => [c.slug, c]));
const curatedEntries =
  (navigationCollections as Record<string, CuratedCollection[]>)[BUILD_LOCALE] ||
  (navigationCollections as Record<string, CuratedCollection[]>).en ||
  [];
const collections = curatedEntries
  .map((entry) => {
    const summary = bySlug.get(entry.slug);
    return summary
      ? { ...entry, productCount: summary.productCount, featuredProductJson: summary.featuredProductJson }
      : null;
  })
  .filter((entry): entry is CuratedCollection & CollectionSummary => entry !== null);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

const metadata = {
  title: ui('collectionsMetaTitle'),
  description: ui('collectionsMetaDescription'),
};
---

<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">{ui('browseBySeries')}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold text-gray-950 sm:text-5xl">{ui('collectionsHeading')}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg sm:leading-8">
        {ui('collectionsIntro')}
      </p>
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-6 py-14 sm:py-16">
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        collections.map((collection) => {
          const featured = JSON.parse(collection.featuredProductJson) as Product;
          return (
            <a
              class="group rounded-2xl border border-black/10 bg-white p-4 transition hover:-translate-y-1 hover:shadow-lg"
              href={`/collections/${collection.slug}`}
            >
              <ProductVisual accent={featured.accent} label={collection.name} imageUrl={featured.imageUrl} />
              <div class="px-2 pb-3 pt-5">
                <p class="text-xs font-semibold uppercase tracking-[.14em] text-primary">
                  {collection.productCount} {ui(collection.productCount === 1 ? 'product' : 'products')}
                </p>
                <h2 class="mt-2 text-2xl font-semibold text-gray-950 group-hover:text-primary">{collection.name}</h2>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
