---
import Layout from '~/layouts/PageLayout.astro';
import { CONTACT_EMAIL, getWhatsAppUrl, WECHAT_ID, WHATSAPP_DISPLAY } from '~/config/contact';

const wechatQrSrc = 'https://rosarybase.com/customer_service/wx.jpg';

const metadata = {
  title: 'Contact Us - Wholesale Rosaries & Custom Religious Gifts',
  description: 'Chat with OUOOO about wholesale rosaries, religious gifts, customization, and packaging.',
};
const product = Astro.url.searchParams.get('product') || '';
const whatsappUrl = getWhatsAppUrl(`Hello OUOOO, I would like to discuss a wholesale sourcing request.

Product or reference: ${product}
Estimated quantity:
Destination country:
Customization or packaging requirements:`);
const emailSubject = product ? `Wholesale inquiry: ${product}` : 'Wholesale inquiry';
const emailUrl = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(emailSubject)}`;
---

<Layout metadata={metadata}>
  <section class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Wholesale contact</p>
      <h1 class="mt-4 text-4xl font-semibold">Talk with our sourcing team.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
        Send the product, quantity, destination, and customization you have in mind. WhatsApp is the fastest way to
        reach us.
      </p>
    </div>
  </section>
  <section class="mx-auto grid max-w-6xl gap-8 px-6 py-16 lg:grid-cols-[.9fr_1.1fr]">
    <aside class="rounded-2xl bg-[#f6f1e8] p-7">
      <h2 class="text-2xl font-semibold">A useful message includes</h2>
      <ul class="mt-6 space-y-4 text-muted">
        <li>✓ Product name or reference</li>
        <li>✓ Estimated quantity</li>
        <li>✓ Destination country</li>
        <li>✓ Material or color preference</li>
        <li>✓ Packaging and private-label needs</li>
      </ul>
      <h2 class="mt-10 text-2xl font-semibold">What we do best</h2>
      <ul class="mt-6 space-y-4 text-muted">
        <li>✓ Specializing in Catholic rosaries and Catholic gifts</li>
        <li>✓ A wide range of related religious accessories and findings</li>
        <li>✓ Large ready-to-ship inventory for quick wholesale support</li>
      </ul>
    </aside>
    <div class="grid gap-5">
      <a
        class="rounded-2xl border border-black/10 bg-white p-7 transition hover:-translate-y-0.5 hover:border-primary"
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Recommended</p>
        <h2 class="mt-3 text-2xl font-semibold">Chat on WhatsApp</h2>
        <p class="mt-2 text-sm font-semibold text-gray-700" dir="ltr">{WHATSAPP_DISPLAY}</p>
        <p class="mt-3 leading-7 text-muted">
          Open a prepared message and add your quantity, country, and requirements.
        </p>
        <span class="mt-5 inline-block font-semibold text-primary">Start a WhatsApp chat →</span>
      </a>
      <article class="rounded-2xl border border-black/10 bg-white p-7">
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">WeChat</p>
        <div class="mt-4 flex flex-col gap-5 sm:flex-row sm:items-center">
          <img
            class="h-32 w-32 rounded-xl border border-black/10"
            src={wechatQrSrc}
            width="200"
            height="200"
            alt={`WeChat QR code for ${WECHAT_ID}`}
            loading="lazy"
          />
          <div>
            <h2 class="text-2xl font-semibold">{WECHAT_ID}</h2>
            <p class="mt-3 leading-7 text-muted">Scan the QR code or search our WeChat ID to start a conversation.</p>
          </div>
        </div>
      </article>
      <a
        class="rounded-2xl border border-black/10 bg-white p-7 transition hover:-translate-y-0.5 hover:border-primary"
        href={emailUrl}
      >
        <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">Email fallback</p>
        <h2 class="mt-3 text-2xl font-semibold" dir="ltr">{CONTACT_EMAIL}</h2>
        <p class="mt-3 leading-7 text-muted">
          Use email when you need to attach specifications, artwork, or sourcing files.
        </p>
        <span class="mt-5 inline-block font-semibold text-primary">Write an email →</span>
      </a>
    </div>
  </section>
</Layout>
