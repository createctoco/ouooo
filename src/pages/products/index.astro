---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { BUILD_LOCALE } from '~/i18n/config';
import { ui } from '~/i18n/ui';
import { listCollections, listProducts, searchProducts } from '~/server/catalog';
export const prerender = false;
const query = (Astro.url.searchParams.get('q') || '').trim().slice(0, 80);
const isSearch = query.length > 0;
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const [{ products, total, page, pageSize }, collections] = await Promise.all([
  isSearch
    ? searchProducts(BUILD_LOCALE, query, 48).then((result) => ({
        ...result,
        page: 1,
        pageSize: 48,
      }))
    : listProducts(BUILD_LOCALE, requestedPage, 24),
  listCollections(BUILD_LOCALE),
]);
Astro.response.headers.set(
  'Cache-Control',
  isSearch
    ? 'public, s-maxage=300, stale-while-revalidate=600'
    : 'public, s-maxage=86400, stale-while-revalidate=86400'
);
if (isSearch) Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
const metadata = {
  title: isSearch ? `${ui('searchProducts')}: ${query} | OUOOO` : ui('productsMetaTitle'),
  description: ui('productsMetaDescription'),
};
---

<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">{ui('wholesaleCatalog')}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-gray-950 sm:text-5xl">
        {ui('productsHeading')}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
        {ui('productsIntro')}
      </p>
      <form method="get" action="/products" role="search" class="mt-8 max-w-3xl">
        <div class="flex flex-col gap-3 rounded-2xl border border-black/10 bg-white p-3 shadow-sm sm:flex-row">
          <label class="sr-only" for="product-search">{ui('searchProducts')}</label>
          <input
            id="product-search"
            name="q"
            type="search"
            value={query}
            placeholder={ui('searchPlaceholder')}
            maxlength="80"
            autocomplete="off"
            enterkeyhint="search"
            class="min-w-0 flex-1 rounded-xl border border-black/10 bg-[#faf9f6] px-4 py-3 text-base text-gray-950 outline-none transition placeholder:text-gray-500 focus:border-primary focus:ring-2 focus:ring-primary/15"
          />
          <button
            type="submit"
            class="rounded-xl bg-primary px-7 py-3 font-semibold text-white transition hover:opacity-90"
          >
            {ui('searchButton')}
          </button>
        </div>
        {
          isSearch && (
            <a
              href="/products"
              class="mt-3 inline-flex text-sm font-medium text-primary hover:underline"
            >
              {ui('clearSearch')}
            </a>
          )
        }
      </form>
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-6 py-16">
    {
      !isSearch && (
        <nav class="mb-10 flex flex-wrap gap-3" aria-label={ui('productCollectionsAria')}>
          {collections.map((collection) => (
            <a
              class="rounded-full border border-black/15 px-4 py-2 text-sm font-medium text-gray-800 transition hover:border-primary hover:text-primary"
              href={`/collections/${collection.slug}`}
            >
              {collection.name} <span class="text-muted">({collection.productCount})</span>
            </a>
          ))}
        </nav>
      )
    }
    <p class="mb-10 text-sm text-muted">
      {isSearch ? ui('searchResults', { total, query }) : ui('showingProducts', { shown: products.length, total })}
    </p>
    <div class="grid gap-x-7 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
    {
      isSearch && products.length === 0 && (
        <p class="rounded-2xl border border-black/10 bg-[#f6f1e8] px-6 py-8 text-center text-muted">
          {ui('noSearchResults', { query })}
        </p>
      )
    }
    {
      !isSearch && total > pageSize && (
        <nav class="mt-12 flex justify-center gap-4" aria-label="Product pagination">
          {page > 1 && <a href={`?page=${page - 1}`}>{ui('previous')}</a>}
          <span>{ui('pageOf', { page, pages: Math.ceil(total / pageSize) })}</span>
          {page * pageSize < total && <a href={`?page=${page + 1}`}>{ui('next')}</a>}
        </nav>
      )
    }
  </section>
</Layout>
