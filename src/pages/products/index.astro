---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { BUILD_LOCALE } from '~/i18n/config';
import { ui } from '~/i18n/ui';
import { listCollections, listProducts } from '~/server/catalog';
export const prerender = false;
const requestedPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
const [{ products, total, page, pageSize }, collections] = await Promise.all([
  listProducts(BUILD_LOCALE, requestedPage, 24),
  listCollections(BUILD_LOCALE),
]);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');
const metadata = {
  title: ui('productsMetaTitle'),
  description: ui('productsMetaDescription'),
};
---

<Layout metadata={metadata}>
  <header class="bg-[#f6f1e8]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-xs font-semibold uppercase tracking-[.16em] text-primary">{ui('wholesaleCatalog')}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-semibold leading-tight text-gray-950 sm:text-5xl">
        {ui('productsHeading')}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">
        {ui('productsIntro')}
      </p>
    </div>
  </header>
  <section class="mx-auto max-w-7xl px-6 py-16">
    <nav class="mb-10 flex flex-wrap gap-3" aria-label={ui('productCollectionsAria')}>
      {
        collections.map((collection) => (
          <a
            class="rounded-full border border-black/15 px-4 py-2 text-sm font-medium text-gray-800 transition hover:border-primary hover:text-primary"
            href={`/collections/${collection.slug}`}
          >
            {collection.name} <span class="text-muted">({collection.productCount})</span>
          </a>
        ))
      }
    </nav>
    <p class="mb-10 text-sm text-muted">{ui('showingProducts', { shown: products.length, total })}</p>
    <div class="grid gap-x-7 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
    {
      total > pageSize && (
        <nav class="mt-12 flex justify-center gap-4" aria-label="Product pagination">
          {page > 1 && <a href={`?page=${page - 1}`}>{ui('previous')}</a>}
          <span>{ui('pageOf', { page, pages: Math.ceil(total / pageSize) })}</span>
          {page * pageSize < total && <a href={`?page=${page + 1}`}>{ui('next')}</a>}
        </nav>
      )
    }
  </section>
</Layout>
