---
import Layout from '~/layouts/PageLayout.astro';
import ProductGallery from '~/components/ouooo/ProductGallery.astro';
import ProductCard from '~/components/ouooo/ProductCard.astro';
import { CONTACT_EMAIL, getProductWhatsAppUrl } from '~/config/contact';
import { BUILD_LOCALE } from '~/i18n/config';
import { getProductBySlug, getRelatedProducts } from '~/server/catalog';

export const prerender = false;

const product = await getProductBySlug(BUILD_LOCALE, Astro.params.slug || '');
if (!product) return new Response(null, { status: 404, statusText: 'Product not found' });
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');
const metadata = { title: product.title, description: product.summary };
const related = await getRelatedProducts(product, 3);
const schemas = Object.values(product.structuredData).filter(Boolean);
const inquiryUrl = getProductWhatsAppUrl({
  title: product.title,
  reference: product.sku || product.sourceId,
  url: new URL(`/products/${product.slug}`, Astro.site).toString(),
});
const inquiryEmailUrl = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Wholesale inquiry: ${product.title}`)}&body=${encodeURIComponent(
  `Hello OUOOO,\n\nI am interested in ${product.title}.\nReference: ${product.sku || product.sourceId}\nLink: ${new URL(`/products/${product.slug}`, Astro.site).toString()}\n\nEstimated quantity:\nDestination country:\nCustomization or packaging requirements:`
)}`;
const visibleSpecifications = product.specifications.slice(0, 8);
const extraSpecifications = product.specifications.slice(8);
const pricing = product.pricing;
const currencySymbol = pricing?.currency === 'EUR' ? '\u20ac' : pricing?.currency === 'CNY' ? '\u00a5' : '$';
const formatPrice = (value: string) =>
  `${currencySymbol}${Number(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
---

<Layout metadata={metadata}>
  {schemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  <section class="mx-auto grid max-w-7xl gap-12 px-6 py-14 lg:grid-cols-2 lg:py-20">
    <ProductGallery product={product} />
    <div class="min-w-0 lg:py-7">
      <nav class="mb-5 flex flex-wrap gap-2" aria-label="Product collections">
        {
          product.categories.map((category) => (
            <a
              class="rounded-full border border-black/15 px-3 py-1 text-xs font-semibold text-gray-700 hover:border-primary hover:text-primary"
              href={`/collections/${category.slug}`}
            >
              {category.name}
            </a>
          ))
        }
      </nav>
      <p class="text-xs font-semibold uppercase tracking-[.14em] text-primary">{product.eyebrow}</p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-gray-950 sm:text-4xl">
        {product.title}
      </h1>
      <p class="mt-6 text-lg leading-8 text-muted">{product.summary}</p>
      {
        pricing && (
          <div class="mt-6 flex items-baseline gap-3">
            {pricing.priceRange ? (
              <span class="text-2xl font-bold text-gray-950">
                {formatPrice(pricing.priceRange.min)} {'\u2013'} {formatPrice(pricing.priceRange.max)}
              </span>
            ) : (
              <span class="text-2xl font-bold text-gray-950">{formatPrice(pricing.price)}</span>
            )}
            {pricing.onSale && pricing.regularPrice && (
              <span class="text-lg text-muted line-through">{formatPrice(pricing.regularPrice)}</span>
            )}
            <span class="text-sm text-muted">/ unit</span>
          </div>
        )
      }
      {
        product.variantImages.length > 0 && (
          <div class="variant-panel">
            <p class="text-xs font-semibold uppercase tracking-[.14em] text-primary">Available variants</p>
            <div class="variant-strip" aria-label="Product variants">
              {product.variantImages.map((variant) => (
                <button
                  type="button"
                  class="variant-thumbnail"
                  data-sku-image={variant.url}
                  data-sku-alt={variant.alt}
                  aria-pressed="false"
                  title={variant.label}
                >
                  <img src={variant.url} alt="" width="80" height="80" loading="lazy" decoding="async" />
                  <span>{variant.label}</span>
                </button>
              ))}
            </div>
          </div>
        )
      }
      <button
        type="button"
        class="btn-primary mt-8"
        data-contact-trigger
        data-whatsapp-url={inquiryUrl}
        data-email-url={inquiryEmailUrl}
      >
        Contact us about this product
      </button>
    </div>
  </section>

  <section class="bg-[#f4f5f2] py-16">
    <div class="mx-auto grid max-w-7xl gap-6 px-6 md:grid-cols-2 md:items-stretch">
      <article class="detail-card">
        <p class="card-kicker">Product details</p>
        <h2>Overview</h2>
        <div class="mt-5 space-y-4 leading-7 text-gray-700">
          {
            product.description
              .split(/\n+/)
              .filter(Boolean)
              .map((paragraph) => <p>{paragraph}</p>)
          }
        </div>
        {
          product.applications.length > 0 && (
            <div class="mt-6">
              <>
                <h3>Applications</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {product.applications.slice(0, 4).map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </>
            </div>
          )
        }
      </article>

      <article class="detail-card">
        <p class="card-kicker">At a glance</p>
        <h2>Key features</h2>
        <ul class="mt-5 grid gap-3">
          {
            product.features.slice(0, 6).map((feature) => (
              <li class="feature-item">
                <>
                  <span>✓</span>
                  <span>{feature}</span>
                </>
              </li>
            ))
          }
        </ul>
        {
          product.catholicContext && (
            <div class="context-box">
              <>
                <h3>Catholic context</h3>
                <p>{product.catholicContext}</p>
              </>
            </div>
          )
        }
      </article>

      <article class="detail-card">
        <p class="card-kicker">Verified product data</p>
        <h2>Specifications</h2>
        <dl class="mt-5 divide-y divide-black/10 border-y border-black/10">
          {
            visibleSpecifications.map((item) => (
              <div class="spec-row">
                <>
                  <dt>{item.name}</dt>
                  <dd>{item.value}</dd>
                </>
              </div>
            ))
          }
        </dl>
        {
          extraSpecifications.length > 0 && (
            <details class="mt-4">
              <>
                <summary class="cursor-pointer font-semibold text-primary">
                  View all specifications ({product.specifications.length})
                </summary>
                <dl class="mt-3 divide-y divide-black/10">
                  {extraSpecifications.map((item) => (
                    <div class="spec-row">
                      <dt>{item.name}</dt>
                      <dd>{item.value}</dd>
                    </div>
                  ))}
                </dl>
              </>
            </details>
          )
        }
      </article>

      <article class="detail-card">
        <p class="card-kicker">Wholesale sourcing</p>
        <h2>Buyer questions</h2>
        {
          product.faq.length > 0 ? (
            <div class="mt-5 divide-y divide-black/10">
              {product.faq.slice(0, 4).map((item) => (
                <details class="py-4">
                  <summary class="cursor-pointer font-semibold text-gray-950">{item.question}</summary>
                  <p class="mt-3 leading-7 text-muted">{item.answer}</p>
                </details>
              ))}
            </div>
          ) : (
            <p class="mt-5 leading-7 text-muted">
              Contact us with your quantity, market, or specification questions. We will confirm the available product
              details.
            </p>
          )
        }
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20">
    <h2 class="text-3xl font-semibold">Related products</h2><div class="mt-9 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((item) => <ProductCard product={item} />)}
    </div>
  </section>
</Layout>

<style>
  .detail-card {
    width: 100%;
    border: 1px solid rgb(37 42 38/0.09);
    border-radius: 1.25rem;
    background: #fff;
    padding: clamp(1.35rem, 3vw, 2rem);
    box-shadow: 0 12px 34px rgb(36 42 37/0.05);
  }
  @media (min-width: 768px) {
    .detail-card {
      height: 100%;
    }
  }
  .detail-card h2 {
    margin-top: 0.35rem;
    font-family: inherit;
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 600;
    line-height: 1.15;
    color: #171b18;
  }
  .detail-card h3 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3d493f;
  }
  .card-kicker {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: #526a55;
  }
  .feature-item {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.55rem;
    border-radius: 0.8rem;
    background: #f6f7f4;
    padding: 0.85rem 1rem;
    line-height: 1.5;
    color: #303832;
  }
  .feature-item > span:first-child {
    color: #526a55;
    font-weight: 800;
  }
  .context-box {
    margin-top: 1.25rem;
    border-left: 3px solid #526a55;
    border-radius: 0.75rem;
    background: #f4f1e9;
    padding: 1rem 1.1rem;
  }
  .context-box p {
    margin-top: 0.4rem;
    line-height: 1.65;
    color: #5b625c;
  }
  .tag {
    border-radius: 999px;
    background: #eef1ec;
    padding: 0.45rem 0.8rem;
    font-size: 0.78rem;
    color: #485349;
  }
  .spec-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding: 0.75rem 0;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .spec-row dt {
    color: #6b746c;
  }
  .spec-row dd {
    overflow-wrap: anywhere;
    font-weight: 600;
    color: #252b26;
  }
  .variant-panel {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-top: 2rem;
    overflow: hidden;
    border-block: 1px solid rgb(37 42 38/0.1);
    padding-block: 1.1rem;
  }
  .variant-strip {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    gap: 0.65rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.75rem 0.1rem 0.35rem;
    box-sizing: border-box;
    scrollbar-width: thin;
    overscroll-behavior-inline: contain;
  }
  .variant-thumbnail {
    flex: 0 0 4.6rem;
    width: 4.6rem;
    max-width: 4.6rem;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 0.75rem;
    background: #fff;
    padding: 0.2rem;
    text-align: left;
    transition:
      border-color 0.18s ease,
      transform 0.18s ease;
  }
  .variant-thumbnail:hover {
    transform: translateY(-1px);
  }
  .variant-thumbnail[aria-pressed='true'] {
    border-color: #526a55;
  }
  .variant-thumbnail img {
    aspect-ratio: 1;
    width: 100%;
    object-fit: contain;
  }
  .variant-thumbnail span {
    display: block;
    overflow: hidden;
    padding: 0.25rem 0.1rem 0;
    font-size: 0.64rem;
    line-height: 0.85rem;
    color: #5e675f;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .spec-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
